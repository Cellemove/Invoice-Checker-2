# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret is found under: Supabase Dashboard > Project Settings > API > JWT Settings
# Only needed when AUTH_REQUIRED=true.
SUPABASE_JWT_SECRET=your-super-secret-jwt-secret

# Auth -------------------------------------------------------------------
# This is an internal tool: auth is DISCONNECTED by default. Leave AUTH_REQUIRED
# unset/false to skip login entirely; set it to true to re-enable strict JWT
# verification on every endpoint (the auth code stays in place either way).
AUTH_REQUIRED=false
# Comparison runs are attributed to this id while auth is disconnected.
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# Shopify (default / primary store) -------------------------------------
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_API_VERSION=2024-07
#
# Provide EITHER (A) API key + secret, and the app fetches a 24h access token
# itself via the OAuth client credentials grant (recommended), OR (B) a static
# access token pasted from the Shopify admin. If both are set, the static token
# wins. Client credentials requires an app your org develops, installed on a
# store you own.
#
# (A) Client credentials — app obtains the token automatically:
SHOPIFY_API_KEY=your-app-client-id
SHOPIFY_API_SECRET=your-app-client-secret
#
# (B) Static token override (optional — skips the token fetch):
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the fetched tokens are cached (gitignored). Defaults to
# backend/.shopify_tokens.json
# SHOPIFY_TOKEN_STORE_PATH=

# Shopify (additional stores) -------------------------------------------
# Add as many stores as you need by suffixing with an uppercase store key.
# The frontend selects a store by sending `store=<key>` (e.g. store=eu).
# Each store accepts API_KEY+API_SECRET or a static ACCESS_TOKEN.
# SHOPIFY_STORE_URL_EU=https://your-eu-store.myshopify.com
# SHOPIFY_API_KEY_EU=your-eu-app-client-id
# SHOPIFY_API_SECRET_EU=your-eu-app-client-secret
# SHOPIFY_STORE_URL_US=https://your-us-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN_US=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
#
# Alternative scheme: one app (shared client id/secret) across many regional
# stores, each identified by a bare domain. Store key = the region suffix; a
# prefix with no region becomes "default". Credentials are resolved from the
# store's own prefix, falling back to a shorter base prefix, so the shared
# CLIENT_ID/SECRET below cover every CELLUMOVE_<REGION> store.
# CELLUMOVE_SHOPIFY_CLIENT_ID=your-app-client-id
# CELLUMOVE_SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxx
# CELLUMOVE_SHOPIFY_STORE_DOMAIN=main-shop.myshopify.com        # -> store "default"
# CELLUMOVE_DE_SHOPIFY_STORE_DOMAIN=de-shop.myshopify.com       # -> store "de"
# CELLUMOVE_ES_SHOPIFY_STORE_DOMAIN=es-shop.myshopify.com       # -> store "es"

# Quotation (price list) -------------------------------------------------
# Optional: point at a specific quotation .xlsx. If unset, the app uses a
# quotation imported from Google Drive, or the first *quotation*.xlsx in this
# backend folder. QUOTATION_SHEET defaults to the tiered "QTY=1-5" sheet.
# QUOTATION_FILE=./Farid-Cellumove quotation-June.5.xlsx
# QUOTATION_SHEET=QTY=1-5

# Google Drive (service account) -----------------------------------------
# Read invoices/quotations straight from a shared Drive folder. Create a
# service account in GCP, download its JSON key, and share the Drive folder
# with the service account's client_email. Provide the key via a file path OR
# inline JSON (not both).
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Optional: restrict listing to one folder (the id from the folder's URL).
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server -----------------------------------------------------------------
PORT=8000
